# 复制本文件为 .env 后填写。不要把 .env 提交到 git。
# Kimi（月之暗面 / Moonshot）开放平台的密钥。两个变量名任填一个即可。
KIMI_API_KEY=
MOONSHOT_API_KEY=

# OpenAI 兼容 Chat Completions 的 base_url，SDK 会自行拼接 /chat/completions。
# 国内控制台（platform.kimi.com）签发的密钥用 .cn；国际站密钥用 .ai，两边不通用。
KIMI_BASE_URL=https://api.moonshot.cn/v1
# 国际站示例：https://api.moonshot.ai/v1

# 对话模型。2026-11 国内站当前旗舰为 kimi-k3.1-pro，高速版约快 2～3 倍，适合现场演示。
# K3 系列始终思考，不支持 temperature。可用模型以控制台 GET /v1/models 为准。
# 其他可选：kimi-k3.1-pro、kimi-k3。2026-11-01 前注册的账号仍可能有 kimi-k2.6（预计 2026-12 底停用）。
KIMI_MODEL=kimi-k3.1-pro-highspeed

# 仅对 kimi-k3 系列生效：low / high / max。演示用 low，减少等待。
KIMI_REASONING_EFFORT=low

# 单次回答最多生成的 completion token（含思考）。演示问答 2048 足够。
KIMI_MAX_COMPLETION_TOKENS=2048

# 向量方案：local（默认，离线，不需要密钥）。
# 实现是 jieba + BM25 与字符 n-gram TF-IDF 的混合索引，向量写在 storage/index/。
# 不调用 Moonshot Embedding。若以后要换句向量模型，改检索模块即可，对话仍走上面的 Kimi 配置。
EMBEDDING_BACKEND=local

# 语料目录与索引目录。把新的 txt/md/json/pdf/docx/zip 放进 DATA_DIR 后重新 ingest 即可。
DATA_DIR=data
INDEX_DIR=storage/index

# 每次检索带回的片段数，以及送给模型的历史轮数（一轮 = 用户 + 助手）。
TOP_K=5
HISTORY_TURNS=6
